# Portex Server Configuration Template
# Copy this to .env.production and fill in your values

BACKEND_URL=https://portex.space
SERVER_API_KEY=your-server-api-key-here

# Ports
HTTP_PORT=8080
HTTPS_PORT=8443

# TLS (SSL Sertifikaları - opsiyonel, Nginx reverse proxy kullanıyorsan gerekli değil)
TLS_CERT_FILE=/etc/letsencrypt/live/portex.space/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/portex.space/privkey.pem
