[Unit]
Description=Portex Tunnel Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/portex/server
EnvironmentFile=/opt/portex/server/.env.production
ExecStart=/opt/portex/server/portex-server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
